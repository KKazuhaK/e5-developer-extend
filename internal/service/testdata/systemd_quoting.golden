[Unit]
Description=e5extend - keep a Microsoft 365 E5 developer tenant active
# No network ordering: the user manager has no network-online.target and
# the engine retries by itself when the network is down.

[Service]
Type=notify
ExecStart="/opt/my apps/e5extend" run --log-format json
Restart=on-failure
RestartSec=30
WatchdogSec=120
TimeoutStopSec=30
Environment="E5EXTEND_CONFIG_DIR=/home/u/my config/100%%"
Environment=E5EXTEND_DATA_DIR=/data

[Install]
WantedBy=default.target
