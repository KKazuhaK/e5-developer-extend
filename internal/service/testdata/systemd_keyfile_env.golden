[Unit]
Description=e5extend - keep a Microsoft 365 E5 developer tenant active
# No network ordering: the user manager has no network-online.target and
# the engine retries by itself when the network is down.

[Service]
Type=notify
ExecStart=/home/u/.local/bin/e5extend run --log-format json
Restart=on-failure
RestartSec=30
WatchdogSec=120
TimeoutStopSec=30
Environment=E5EXTEND_MASTER_KEY_FILE=/home/u/.config/e5extend/master.key
Environment=E5EXTEND_CONFIG_DIR=/home/u/.config/e5extend
Environment=E5EXTEND_DATA_DIR=/home/u/.local/share/e5extend

[Install]
WantedBy=default.target
